{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_output.schema.json",
  "title": "Joern Analysis Output v1.0",
  "description": "Frozen output contract for all joern-code-analysis skill queries. Increment schema_version on any breaking change.",
  "type": "object",
  "required": ["schema_version", "query", "status", "truncated"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "MAJOR.MINOR — bump MINOR for additive changes, MAJOR for breaking"
    },
    "query": {
      "type": "string",
      "enum": ["callgraph", "cfg_summary", "dataflow", "compare_variants", "env_branches"],
      "description": "Which analysis was run"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "error", "timeout", "cpg_not_found"],
      "description": "ok = success; others carry error_message"
    },
    "error_message": {
      "type": "string",
      "description": "Present when status != ok"
    },
    "target": {
      "type": "object",
      "description": "Query-specific target identifiers",
      "additionalProperties": { "type": "string" }
    },
    "truncated": {
      "type": "boolean",
      "description": "true when results were capped by --max-results"
    },
    "result": {
      "type": "object",
      "description": "Query-specific result object; absent when status != ok",
      "oneOf": [
        { "$ref": "#/$defs/callgraph_result" },
        { "$ref": "#/$defs/cfg_summary_result" },
        { "$ref": "#/$defs/dataflow_result" },
        { "$ref": "#/$defs/compare_variants_result" },
        { "$ref": "#/$defs/env_branches_result" }
      ]
    }
  },
  "if": { "properties": { "status": { "const": "ok" } } },
  "then": { "required": ["result"] },
  "else": { "required": ["error_message"] },

  "$defs": {
    "call_node": {
      "type": "object",
      "required": ["name", "file", "line", "depth_from_target"],
      "properties": {
        "name":             { "type": "string" },
        "file":             { "type": "string" },
        "line":             { "type": "integer" },
        "depth_from_target":{ "type": "integer", "minimum": 1 }
      }
    },

    "callgraph_result": {
      "type": "object",
      "required": ["function", "depth", "callers", "callees", "total_callers", "total_callees"],
      "properties": {
        "function":      { "type": "string" },
        "depth":         { "type": "integer", "minimum": 1 },
        "callers":       { "type": "array", "items": { "$ref": "#/$defs/call_node" } },
        "callees":       { "type": "array", "items": { "$ref": "#/$defs/call_node" } },
        "total_callers": { "type": "integer", "minimum": 0 },
        "total_callees": { "type": "integer", "minimum": 0 }
      }
    },

    "cfg_summary_result": {
      "type": "object",
      "required": ["function", "basic_blocks", "branch_points", "unreachable_blocks", "cyclomatic_complexity", "summary"],
      "properties": {
        "function":              { "type": "string" },
        "basic_blocks":          { "type": "integer", "minimum": 0 },
        "branch_points":         { "type": "integer", "minimum": 0 },
        "unreachable_blocks":    { "type": "integer", "minimum": 0 },
        "cyclomatic_complexity": { "type": "integer", "minimum": 1 },
        "summary":               { "type": "string" }
      }
    },

    "flow_path": {
      "type": "object",
      "required": ["summary", "hops", "nodes"],
      "properties": {
        "summary": { "type": "string" },
        "hops":    { "type": "integer", "minimum": 1 },
        "nodes":   { "type": "array", "items": { "type": "string" } }
      }
    },

    "dataflow_result": {
      "type": "object",
      "required": ["source", "sink", "reachable", "paths", "total_paths_found"],
      "properties": {
        "source":            { "type": "string" },
        "sink":              { "type": "string" },
        "reachable":         { "type": "boolean" },
        "paths":             { "type": "array", "items": { "$ref": "#/$defs/flow_path" } },
        "total_paths_found": { "type": "integer", "minimum": 0 }
      }
    },

    "compare_variants_result": {
      "type": "object",
      "required": ["only_in_variant_a", "only_in_variant_b", "shared_functions", "changed_call_graph", "summary"],
      "properties": {
        "only_in_variant_a":  { "type": "array", "items": { "type": "string" } },
        "only_in_variant_b":  { "type": "array", "items": { "type": "string" } },
        "shared_functions":   { "type": "integer", "minimum": 0 },
        "changed_call_graph": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["function", "added_calls_in_b", "removed_calls_in_b"],
            "properties": {
              "function":          { "type": "string" },
              "added_calls_in_b":  { "type": "array", "items": { "type": "string" } },
              "removed_calls_in_b":{ "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "summary": { "type": "string" }
      }
    },

    "env_branch": {
      "type": "object",
      "required": ["function", "file", "line", "control_structure", "condition"],
      "properties": {
        "function":          { "type": "string" },
        "file":              { "type": "string" },
        "line":              { "type": "integer" },
        "control_structure": { "type": "string" },
        "condition":         { "type": "string" }
      }
    },

    "env_branches_result": {
      "type": "object",
      "required": ["env_sensitive_branches", "total_found"],
      "properties": {
        "env_sensitive_branches": {
          "type": "array",
          "items": { "$ref": "#/$defs/env_branch" }
        },
        "total_found": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
